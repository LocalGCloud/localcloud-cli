+class ScopeStack:
+    """BigQuery-style block scope stack for scripting variables."""
+
+    def __init__(self) -> None:
+        self._scopes: list[dict[str, str]] = [{}]
+        self._counter = 0
+
+    def enter_block(self) -> None:
+        self._scopes.append({})
+
+    def exit_block(self) -> None:
+        if len(self._scopes) > 1:
+            self._scopes.pop()
+
+    def declare(self, name: str) -> str:
+        logical = name.lower()
+        self._counter += 1
+        physical = f"__bqv_{self._counter}_{logical}"
+        self._scopes[-1][logical] = physical
+        return physical
+
+    def set(self, name: str) -> str:
+        logical = name.lower()
+        for scope in reversed(self._scopes):
+            if logical in scope:
+                return scope[logical]
+        return self.declare(name)
+
+    def get(self, name: str) -> str | None:
+        logical = name.lower()
+        for scope in reversed(self._scopes):
+            if logical in scope:
+                return scope[logical]
+        return None
+
+    def visible_names(self) -> set[str]:
+        names: set[str] = set()
+        for scope in self._scopes:
+            names.update(scope)
+        return names
+
