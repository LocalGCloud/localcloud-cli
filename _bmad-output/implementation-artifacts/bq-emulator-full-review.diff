+def _build_partitions_view_sql(conn: duckdb.DuckDBPyConnection, dataset_id: str) -> str:
+    """Build PARTITIONS view SQL with real DISTINCT partition values where known."""
+    base_columns = (
+        "table_catalog, table_schema, table_name, partition_id, "
+        "last_modified_time, total_rows, total_logical_bytes, total_billable_bytes"
+    )
+    selects: list[str] = []
+    try:
+        partition_rows = conn.execute(
+            'SELECT table_name, partition_field FROM "__table_partitions" WHERE table_schema = ?',
+            [dataset_id],
+        ).fetchall()
+    except Exception:
+        partition_rows = []
+
+    partitioned_tables = {str(table) for table, _field in partition_rows}
+    for table_name, partition_field in partition_rows:
+        table_ident = _quote_ident(str(table_name))
+        field_ident = _quote_ident(str(partition_field))
+        dataset_ident = _quote_ident(dataset_id)
+        selects.append(f"""
+            SELECT
+                '' AS table_catalog,
+                '{dataset_id}' AS table_schema,
+                '{table_name}' AS table_name,
+                CAST({field_ident} AS VARCHAR) AS partition_id,
+                NULL::TIMESTAMP AS last_modified_time,
+                COUNT(*)::BIGINT AS total_rows,
+                (COUNT(*) * 8)::BIGINT AS total_logical_bytes,
+                (COUNT(*) * 8)::BIGINT AS total_billable_bytes
+            FROM {dataset_ident}.{table_ident}
+            GROUP BY {field_ident}
+        """)
+
+    try:
+        tables = conn.execute(
+            "SELECT table_catalog, table_name FROM information_schema.tables "
+            "WHERE table_schema = ? AND table_name NOT LIKE 'INFORMATION_SCHEMA%'",
+            [dataset_id],
+        ).fetchall()
+    except Exception:
+        tables = []
+
+    for table_catalog, table_name in tables:
+        if str(table_name) in partitioned_tables:
+            continue
+        selects.append(f"""
+            SELECT
+                '{table_catalog}' AS table_catalog,
+                '{dataset_id}' AS table_schema,
+                '{table_name}' AS table_name,
+                '__NULL__' AS partition_id,
+                NULL::TIMESTAMP AS last_modified_time,
+                COALESCE(dt.estimated_size, 0)::BIGINT AS total_rows,
+                (COALESCE(dt.estimated_size, 0) * GREATEST(COALESCE(dt.column_count, 1), 1) * 8)::BIGINT AS total_logical_bytes,
+                (COALESCE(dt.estimated_size, 0) * GREATEST(COALESCE(dt.column_count, 1), 1) * 8)::BIGINT AS total_billable_bytes
+            FROM duckdb_tables() dt
+            WHERE dt.schema_name = '{dataset_id}' AND dt.table_name = '{table_name}'
+        """)
+
+    body = "\nUNION ALL\n".join(selects) if selects else f"""
+        SELECT
+            '' AS table_catalog,
+            '{dataset_id}' AS table_schema,
+            '' AS table_name,
+            '' AS partition_id,
+            NULL::TIMESTAMP AS last_modified_time,
+            0::BIGINT AS total_rows,
+            0::BIGINT AS total_logical_bytes,
+            0::BIGINT AS total_billable_bytes
+        WHERE 1=0
+    """
+    return f"""
+        CREATE OR REPLACE VIEW "{dataset_id}".INFORMATION_SCHEMA_PARTITIONS AS
+        SELECT {base_columns} FROM (
+            {body}
+        ) AS partitions_src
+    """
