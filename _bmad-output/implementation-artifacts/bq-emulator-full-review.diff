+        r"\s*EXPORT\s+DATA\s+OPTIONS\s*\((.*?)\)\s+AS\s+(SELECT\b.*)\s*;?\s*$",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        raise invalid_query("Could not parse EXPORT DATA statement")
+    options = _parse_options(match.group(1))
+    select_sql = match.group(2).strip().rstrip(";")
+    uri = options.get("uri") or (options.get("uris") or [None])[0]
+    if not uri:
+        raise invalid_query("EXPORT DATA OPTIONS requires uri='...'")
+    try:
+        path = _local_path_from_uri(str(uri))
+    except Exception as e:
+        raise invalid_query(f"EXPORT DATA for this URI/configuration is not supported or failed locally: {e}")
+    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+    fmt = str(options.get("format", "CSV")).upper()
+    transpiler = _get_transpiler(project_id, dataset_id)
+    try:
+        duckdb_sql = transpiler.transpile_query(select_sql)
+    except TranspileError as e:
+        raise invalid_query(str(e))
+    duckdb_sql = _apply_row_access_policies(project_id, dataset_id, duckdb_sql)
+    conn = get_connection_manager().get_connection()
+    try:
+        if dataset_id:
+            from bigquery_emulator.engine.sanitize import duckdb_schema_name
+            schema_name = duckdb_schema_name(project_id, dataset_id)
+            conn.execute(f"SET search_path = '{schema_name},main'")
+        if fmt in ("NEWLINE_DELIMITED_JSON", "JSON"):
+            result = conn.execute(duckdb_sql)
+            columns = [str(c[0]) for c in result.description or []]
+            with open(path, "w", encoding="utf-8") as f:
+                for row in result.fetchall():
+                    f.write(json.dumps(dict(zip(columns, row)), default=str) + "\n")
+        elif fmt == "CSV":
+            conn.execute(f"COPY ({duckdb_sql}) TO ? (FORMAT CSV, HEADER true)", [path])
+        elif fmt == "PARQUET":
+            conn.execute(f"COPY ({duckdb_sql}) TO ? (FORMAT PARQUET)", [path])
+        else:
+            raise invalid_query(f"Unsupported EXPORT DATA format: {fmt}")
+    finally:
+        conn.close()
+
