+def _handle_create_search_index(project_id: str, original_sql: str, dataset_id: str) -> None:
+    """Implement CREATE SEARCH INDEX metadata plus best-effort DuckDB FTS index."""
+    match = re.match(
+        r"\s*CREATE\s+(?:OR\s+REPLACE\s+)?SEARCH\s+INDEX\s+`?(\w+)`?\s+ON\s+(.+?)\s*\((.*?)\)",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        raise invalid_query("Could not parse CREATE SEARCH INDEX")
+    index_name, table_ref, cols_sql = match.groups()
+    ds, table = _parse_table_ref(table_ref, dataset_id)
+    columns = [c.strip().strip("`") for c in cols_sql.split(",") if c.strip()]
+    key = f"{project_id}.{ds}.{table}.{index_name}"
+    _SEARCH_INDEXES[key] = {"dataset": ds, "table": table, "columns": columns}
+    from bigquery_emulator.engine.sanitize import duckdb_schema_name
+
+    schema = duckdb_schema_name(project_id, ds)
+    conn = get_connection_manager().get_connection()
+    try:
+        try:
+            conn.execute("INSTALL fts")
+            conn.execute("LOAD fts")
+            id_col = columns[0] if columns else "*"
+            value_cols = columns[1:] or columns or ["*"]
+            args = ", ".join([f"'{schema}.{table}'", f"'{id_col}'"] + [f"'{c}'" for c in value_cols])
+            conn.execute(f"PRAGMA create_fts_index({args}, overwrite=1)")
+        except Exception as e:
+            logger.info("DuckDB FTS index unavailable; SEARCH() will use scalar fallback: %s", e)
+    finally:
+        conn.close()
+
