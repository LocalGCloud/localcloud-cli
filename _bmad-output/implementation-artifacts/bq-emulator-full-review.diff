+def _handle_extract_job(project_id: str, job_id: str, extract_config: dict, store) -> None:
+    """Handle REST EXTRACT jobs to local files or file:// URIs."""
+    source = extract_config.get("sourceTable", {})
+    dest_uris = extract_config.get("destinationUris", [])
+    dataset_id = source.get("datasetId", "")
+    table_id = source.get("tableId", "")
+    if not dataset_id or not table_id or not dest_uris:
+        store.complete_job(project_id, job_id, error={"reason": "invalid", "message": "extract.sourceTable and destinationUris are required"})
+        return
+
+    destination_format = extract_config.get("destinationFormat", "CSV").upper()
+    conn_mgr = get_connection_manager()
+    from bigquery_emulator.engine.sanitize import duckdb_schema_name
+    schema_name = duckdb_schema_name(project_id, dataset_id)
+    try:
+        conn = conn_mgr.get_connection()
+        try:
+            result = conn.execute(f'SELECT * FROM "{schema_name}"."{table_id}"')
+            columns = [str(c[0]) for c in result.description or []]
+            rows = result.fetchall()
+        finally:
+            conn.close()
+
+        if len(dest_uris) != 1:
+            raise ValueError("Only one extract destination URI is supported by the emulator")
+        path = _local_path_from_uri(dest_uris[0])
+        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+
+        if destination_format in ("NEWLINE_DELIMITED_JSON", "JSON"):
+            with open(path, "w", encoding="utf-8") as f:
+                for row in rows:
+                    f.write(json.dumps(dict(zip(columns, row)), default=str) + "\n")
+        elif destination_format == "CSV":
+            print_header = extract_config.get("printHeader", True)
+            with open(path, "w", encoding="utf-8", newline="") as f:
+                writer = csv.writer(f)
+                if print_header:
+                    writer.writerow(columns)
+                writer.writerows(rows)
+        else:
+            raise ValueError(f"Unsupported extract destinationFormat: {destination_format}")
+
+        completed_job = store.complete_job(project_id, job_id, result={"schema": {"fields": []}, "rows": [], "totalRows": "0"})
+        if completed_job is not None:
+            output_bytes = os.path.getsize(path)
+            completed_job.statistics.extract = {
+                "destinationUriFileCounts": ["1"],
+                "inputRows": str(len(rows)),
+                "inputBytes": str(output_bytes),
+            }
+    except Exception as e:
+        store.complete_job(project_id, job_id, error={"reason": "invalid", "message": str(e)})
+
