+
+def _infer_select_output(select: exp.Select, context: TypeInferenceContext) -> dict[str, str]:
+    output: dict[str, str] = {}
+    from_expr = select.args.get("from_")
+    if from_expr and from_expr.this is not None:
+        _infer_source_relation(from_expr.this, context)
+    for join in select.args.get("joins") or []:
+        if join.this is not None:
+            _infer_source_relation(join.this, context)
+
+    for projection in select.expressions:
+        if isinstance(projection, exp.Star):
+            output.update(context.unqualified_columns)
+            continue
+        alias = projection.alias_or_name
+        expr = projection.this if isinstance(projection, exp.Alias) else projection
+        if not alias and isinstance(expr, exp.Column):
+            alias = expr.name
+        if not alias:
+            continue
+        inferred = _resolve_node_type(expr, context)
+        if inferred:
+            output[alias.lower()] = inferred
+    return output
