+                cte_query = cte.this
+                if isinstance(cte_query, exp.Select):
+                    context.add_relation(cte.alias_or_name, _infer_select_output(cte_query, context))
+
+        from_expr = select.args.get("from_")
+        if from_expr and from_expr.this is not None:
+            _infer_source_relation(from_expr.this, context)
+
+        for join in select.args.get("joins") or []:
+            if join.this is not None:
+                _infer_source_relation(join.this, context)
+
+    for subquery in tree.find_all(exp.Subquery):
+        if isinstance(subquery.this, exp.Select):
+            context.add_relation(subquery.alias_or_name, _infer_select_output(subquery.this, context))
