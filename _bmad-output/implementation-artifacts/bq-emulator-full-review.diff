+def _handle_create_remote_function(project_id: str, original_sql: str, dataset_id: str) -> None:
+    """Register a local HTTP-backed approximation of BigQuery remote functions."""
+    match = re.match(
+        r"\s*CREATE\s+(?:OR\s+REPLACE\s+)?FUNCTION\s+(?:(?:`?(\w+)`?)\.)?`?(\w+)`?\s*\((.*?)\)\s+RETURNS\s+(\w+).*?OPTIONS\s*\((.*?)\)",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        raise invalid_query("Could not parse remote CREATE FUNCTION")
+    fn_dataset = match.group(1) or dataset_id
+    fn_name = match.group(2)
+    args_sql = match.group(3).strip()
+    return_type = match.group(4).upper()
+    options = _parse_options(match.group(5))
+    endpoint = options.get("endpoint")
+    if not endpoint:
+        raise invalid_query("REMOTE function OPTIONS must include endpoint")
+    _REMOTE_FUNCTIONS[fn_name.upper()] = {
+        "dataset": fn_dataset,
+        "endpoint": str(endpoint),
+        "return_type": return_type,
+        "arg_count": len([p for p in args_sql.split(",") if p.strip()]),
+    }
+
+
+def _try_handle_remote_function_select(original_sql: str) -> dict[str, Any] | None:
+    match = re.match(
+        r"\s*SELECT\s+`?(\w+)`?\s*\((.*?)\)(?:\s+AS\s+`?(\w+)`?)?\s*;?\s*$",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        return None
+    fn_name, args_sql, alias = match.groups()
+    fn = _REMOTE_FUNCTIONS.get(fn_name.upper())
+    if not fn:
+        return None
+    args = []
+    for raw in [a.strip() for a in args_sql.split(",") if a.strip()]:
+        if (raw.startswith("'") and raw.endswith("'")) or (raw.startswith('"') and raw.endswith('"')):
+            args.append(raw[1:-1])
+        elif re.match(r"^-?\d+$", raw):
+            args.append(int(raw))
+        elif re.match(r"^-?\d+\.\d+$", raw):
+            args.append(float(raw))
+        else:
+            args.append(raw)
+    import requests
+
+    response = requests.post(fn["endpoint"], json={"calls": [args]}, timeout=10)
+    response.raise_for_status()
+    payload = response.json()
+    value = (payload.get("replies") or [None])[0]
+    col = alias or fn_name
+    bq_type = fn.get("return_type", "STRING")
+    return {
+        "schema": {"fields": [{"name": col, "type": bq_type, "mode": "NULLABLE"}]},
+        "rows": [{"f": [python_to_bq_value(value, bq_type)]}],
+        "totalRows": "1",
+    }
+
+
+def _handle_external_query(project_id: str, original_sql: str, dataset_id: str) -> dict[str, Any]:
+    """Implement EXTERNAL_QUERY for local SQLite connection strings."""
+    match = re.match(
+        r"\s*SELECT\s+\*\s+FROM\s+EXTERNAL_QUERY\s*\(\s*(['\"])(.*?)\1\s*,\s*(['\"])(.*?)\3\s*\)\s*;?\s*$",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        raise invalid_query("EXTERNAL_QUERY currently supports SELECT * FROM EXTERNAL_QUERY('sqlite:/path.db', 'query')")
+    conn_id = match.group(2)
+    remote_sql = match.group(4)
+    if not conn_id.startswith("sqlite:"):
+        raise invalid_query("Only sqlite:/path connection strings are supported for local EXTERNAL_QUERY")
+    db_path = conn_id[len("sqlite:"):]
+    ext = sqlite3.connect(db_path)
+    try:
+        cur = ext.execute(remote_sql)
+        rows = cur.fetchall()
+        columns = [d[0] for d in cur.description or []]
+    finally:
+        ext.close()
+    schema_fields = [{"name": c, "type": "STRING", "mode": "NULLABLE"} for c in columns]
+    formatted = [{"f": [{"v": None if v is None else str(v)} for v in row]} for row in rows]
+    return {"schema": {"fields": schema_fields}, "rows": formatted, "totalRows": str(len(rows))}
+
+
+def _try_handle_vector_search(project_id: str, original_sql: str, dataset_id: str) -> dict[str, Any] | None:
+    match = re.match(
+        r"\s*SELECT\s+\*\s+FROM\s+VECTOR_SEARCH\s*\(\s*TABLE\s+(.+?)\s*,\s*['\"](\w+)['\"]\s*,\s*\[(.*?)\]\s*(?:,\s*(\d+))?\s*\)\s*;?\s*$",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        return None
+    table_ref, col, vector_sql, top_k = match.groups()
+    ds, table = _parse_table_ref(table_ref, dataset_id)
+    top = int(top_k or 10)
+    query_vector = [float(x.strip()) for x in vector_sql.split(",") if x.strip()]
+    from bigquery_emulator.engine.sanitize import duckdb_schema_name
+
+    schema = duckdb_schema_name(project_id, ds)
+    conn = get_connection_manager().get_connection()
+    try:
+        sql = (
+            f'SELECT *, VECTOR_DISTANCE("{col}", ?) AS distance '
+            f'FROM "{schema}"."{table}" ORDER BY distance LIMIT {top}'
+        )
+        result = conn.execute(sql, [query_vector])
+        return _duckdb_result_to_bq(result)
+    finally:
+        conn.close()
+
+
+def _try_handle_gap_fill(project_id: str, original_sql: str, dataset_id: str) -> dict[str, Any] | None:
+    match = re.match(
+        r"\s*SELECT\s+\*\s+FROM\s+GAP_FILL\s*\(\s*TABLE\s+(.+?)\s*,\s*ts_column\s*=>\s*['\"](\w+)['\"]\s*,\s*bucket_width\s*=>\s*INTERVAL\s+(\d+)\s+(\w+)(?:\s*,\s*value_column\s*=>\s*['\"](\w+)['\"])?\s*\)\s*;?\s*$",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        return None
+    table_ref, ts_col, width_count, width_unit, value_col = match.groups()
+    ds, table = _parse_table_ref(table_ref, dataset_id)
+    value_col = value_col or "value"
+    from bigquery_emulator.engine.sanitize import duckdb_schema_name
+
+    schema = duckdb_schema_name(project_id, ds)
+    conn = get_connection_manager().get_connection()
+    try:
+        sql = f'''
+            WITH bounds AS (
+                SELECT min("{ts_col}") AS min_ts, max("{ts_col}") AS max_ts FROM "{schema}"."{table}"
+            ),
+            series AS (
+                SELECT CAST(generate_series AS TIMESTAMP) AS "{ts_col}"
+                FROM bounds, generate_series(min_ts, max_ts, INTERVAL {int(width_count)} {width_unit.upper()})
+            )
+            SELECT strftime(s."{ts_col}", '%Y-%m-%d %H:%M:%S') AS "{ts_col}", t."{value_col}"
+            FROM series s
+            LEFT JOIN "{schema}"."{table}" t USING ("{ts_col}")
+            ORDER BY s."{ts_col}"
+        '''
+        return _duckdb_result_to_bq(conn.execute(sql))
+    finally:
+        conn.close()
+
