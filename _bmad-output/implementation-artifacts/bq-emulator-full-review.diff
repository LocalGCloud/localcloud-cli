+def _handle_create_vector_index(project_id: str, original_sql: str, dataset_id: str) -> None:
+    """Implement CREATE VECTOR INDEX metadata plus best-effort DuckDB HNSW index."""
+    match = re.match(
+        r"\s*CREATE\s+(?:OR\s+REPLACE\s+)?VECTOR\s+INDEX\s+`?(\w+)`?\s+ON\s+(.+?)\s*\((`?\w+`?)\)",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        raise invalid_query("Could not parse CREATE VECTOR INDEX")
+    index_name, table_ref, col = match.groups()
+    ds, table = _parse_table_ref(table_ref, dataset_id)
+    col = col.strip("`")
+    _VECTOR_INDEXES[f"{project_id}.{ds}.{table}.{index_name}"] = {"dataset": ds, "table": table, "column": col}
+    from bigquery_emulator.engine.sanitize import duckdb_schema_name
+
+    schema = duckdb_schema_name(project_id, ds)
+    conn = get_connection_manager().get_connection()
+    try:
+        try:
+            conn.execute("INSTALL vss")
+            conn.execute("LOAD vss")
+            conn.execute(f'CREATE INDEX IF NOT EXISTS "{index_name}" ON "{schema}"."{table}" USING HNSW ("{col}")')
+        except Exception as e:
+            logger.info("DuckDB VSS index unavailable; VECTOR_SEARCH will use ORDER BY fallback: %s", e)
+    finally:
+        conn.close()
+
