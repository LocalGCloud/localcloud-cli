+async def _handle_load_job(project_id: str, job_id: str, load_config: dict, store) -> None:
+    """Handle REST LOAD jobs from local files or file:// URIs."""
+    source_uris = load_config.get("sourceUris", [])
+    if not source_uris:
+        store.complete_job(project_id, job_id, error={"reason": "invalid", "message": "load.sourceUris is required"})
+        return
+
+    source_format = load_config.get("sourceFormat", "NEWLINE_DELIMITED_JSON")
+    job_config = {"configuration": {"load": load_config}}
+    try:
+        from bigquery_emulator.api.rest.upload import _load_data
+        input_bytes = 0
+        input_files = 0
+        for uri in source_uris:
+            data = _read_load_uri(uri)
+            input_bytes += len(data)
+            input_files += 1
+            await _load_data(project_id, job_config, data, source_format)
+        dest = load_config.get("destinationTable", {})
+        output_rows = "0"
+        output_bytes = "0"
+        if dest.get("datasetId") and dest.get("tableId"):
+            output_rows = str(get_connection_manager().get_table_row_count(project_id, dest["datasetId"], dest["tableId"]))
+        completed_job = store.complete_job(project_id, job_id, result={"schema": {"fields": []}, "rows": [], "totalRows": "0"})
+        if completed_job is not None:
+            completed_job.statistics.load = {
+                "inputFiles": str(input_files),
+                "inputFileBytes": str(input_bytes),
+                "outputRows": output_rows,
+                "outputBytes": output_bytes,
+            }
+    except Exception as e:
+        store.complete_job(project_id, job_id, error={"reason": "invalid", "message": str(e)})
+
