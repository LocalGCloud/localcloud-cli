+class TypeInferenceContext:
+    """Tracks table, CTE, subquery, and join output column types."""
+
+    def __init__(self, table_schemas: dict[str, dict[str, str]] | None = None):
+        self.table_schemas = _normalize_schema(table_schemas)
+        self.relations: dict[str, dict[str, str]] = {}
+        self.unqualified_columns: dict[str, str] = {}
+
+    def add_relation(self, name: str | None, columns: dict[str, str] | None) -> None:
+        if not name or not columns:
+            return
+        normalized = {col.lower(): typ.upper() for col, typ in columns.items()}
+        self.relations[name.lower()] = normalized
+        for col, typ in normalized.items():
+            self.unqualified_columns.setdefault(col, typ)
+
+    def relation_schema(self, name: str | None) -> dict[str, str] | None:
+        if not name:
+            return None
+        key = name.lower()
+        if key in self.relations:
+            return self.relations[key]
+        if key in self.table_schemas:
+            return self.table_schemas[key]
+        for table_name, columns in self.table_schemas.items():
+            if table_name == key or table_name.endswith("." + key):
+                return columns
+        return None
+
+    def resolve_column(self, column_name: str, table_name: str | None = None) -> str | None:
+        col_lower = column_name.lower()
+        if table_name:
+            relation = self.relation_schema(table_name)
+            if relation and col_lower in relation:
+                return relation[col_lower]
+            return _resolve_column_type(column_name, self.table_schemas, table_name)
+        if col_lower in self.unqualified_columns:
+            return self.unqualified_columns[col_lower]
+        return _resolve_column_type(column_name, self.table_schemas)
