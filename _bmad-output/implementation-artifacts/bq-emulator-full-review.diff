+def _transform_semi_anti_joins(node: exp.Expression) -> exp.Expression:
+    """Rewrite LEFT SEMI/ANTI JOIN to EXISTS/NOT EXISTS filters.
+
+    BigQuery's SEMI/ANTI joins return only left-side rows. DuckDB lacks this
+    syntax, but EXISTS predicates preserve the developer-visible row semantics
+    for common USING/ON forms.
+    """
+    if not isinstance(node, exp.Select):
+        return node
+
+    joins = list(node.args.get("joins") or [])
+    if not joins:
+        return node
+
+    from_expr = node.args.get("from_")
+    left = from_expr.this if from_expr else None
+    if left is not None:
+        rewritten_joins = []
+        for join in joins:
+            side = (join.args.get("side") or "").upper()
+            kind = (join.args.get("kind") or "").upper()
+            if side == "RIGHT" and kind in ("SEMI", "ANTI"):
+                original_left = left.copy()
+                left = join.this.copy()
+                from_expr.set("this", left)
+                join.set("this", original_left)
+                join.set("side", "LEFT")
+            rewritten_joins.append(join)
+        joins = rewritten_joins
+        node.set("joins", joins)
+
+    left_alias = getattr(left, "alias_or_name", None)
+    remaining = []
+    predicates = []
+
+    for join in joins:
+        side = (join.args.get("side") or "").upper()
+        kind = (join.args.get("kind") or "").upper()
+        if side != "LEFT" or kind not in ("SEMI", "ANTI"):
+            remaining.append(join)
+            continue
+        right = join.this.copy()
+        right_alias = getattr(join.this, "alias_or_name", None)
+        condition = join.args.get("on")
+
+        using_cols = join.args.get("using") or []
+        if condition is None and using_cols and left_alias and right_alias:
+            comparisons = []
+            for ident in using_cols:
+                col = ident.name if hasattr(ident, "name") else str(ident)
+                comparisons.append(exp.column(col, table=left_alias).eq(exp.column(col, table=right_alias)))
+            condition = comparisons[0]
+            for comp in comparisons[1:]:
+                condition = exp.and_(condition, comp)
+
+        if condition is None:
+            raise TranspileError("LEFT SEMI/ANTI JOIN requires USING or ON in the emulator")
+
+        subquery = exp.select("1").from_(right).where(condition.copy())
+        exists_pred = exp.Exists(this=subquery)
+        if kind == "ANTI":
+            exists_pred = exp.Not(this=exists_pred)
+        predicates.append(exists_pred)
+
+    if len(remaining) != len(joins):
+        node.set("joins", remaining)
+        combined = None
+        for pred in predicates:
+            combined = pred if combined is None else exp.and_(combined, pred)
+        existing_where = node.args.get("where")
+        if existing_where:
+            combined = exp.and_(existing_where.this, combined)
+        node.set("where", exp.Where(this=combined))
+
+    return node
