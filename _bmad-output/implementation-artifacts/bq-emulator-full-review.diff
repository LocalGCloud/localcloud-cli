+
+def _infer_source_relation(source: exp.Expression, context: TypeInferenceContext) -> None:
+    if isinstance(source, exp.Table):
+        table_name = source.name
+        schema = context.relation_schema(table_name)
+        context.add_relation(source.alias_or_name or table_name, schema)
+    elif isinstance(source, exp.Subquery) and isinstance(source.this, exp.Select):
+        context.add_relation(source.alias_or_name, _infer_select_output(source.this, context))
