+def _handle_create_row_access_policy(project_id: str, original_sql: str, dataset_id: str) -> None:
+    match = re.match(
+        r"\s*CREATE\s+(?:OR\s+REPLACE\s+)?ROW\s+ACCESS\s+POLICY\s+`?(\w+)`?\s+ON\s+(.+?)\s+FILTER\s+USING\s*\((.*)\)\s*;?\s*$",
+        original_sql,
+        re.IGNORECASE | re.DOTALL,
+    )
+    if not match:
+        raise invalid_query("Could not parse CREATE ROW ACCESS POLICY")
+    policy, table_ref, predicate = match.groups()
+    ds, table = _parse_table_ref(table_ref, dataset_id)
+    _ROW_ACCESS_POLICIES.setdefault(f"{project_id}.{ds}.{table}", {})[policy] = predicate.strip()
+
+
+def _handle_drop_row_access_policy(project_id: str, original_sql: str, dataset_id: str) -> None:
+    all_match = re.match(r"\s*DROP\s+ALL\s+ROW\s+ACCESS\s+POLICIES\s+ON\s+(.+?)\s*;?\s*$", original_sql, re.IGNORECASE)
+    if all_match:
+        ds, table = _parse_table_ref(all_match.group(1), dataset_id)
+        _ROW_ACCESS_POLICIES.pop(f"{project_id}.{ds}.{table}", None)
+        return
+    match = re.match(r"\s*DROP\s+ROW\s+ACCESS\s+POLICY\s+`?(\w+)`?\s+ON\s+(.+?)\s*;?\s*$", original_sql, re.IGNORECASE)
+    if not match:
+        raise invalid_query("Could not parse DROP ROW ACCESS POLICY")
+    policy, table_ref = match.groups()
+    ds, table = _parse_table_ref(table_ref, dataset_id)
+    _ROW_ACCESS_POLICIES.get(f"{project_id}.{ds}.{table}", {}).pop(policy, None)
+
+
+def _apply_row_access_policies(project_id: str, dataset_id: str, duckdb_sql: str) -> str:
+    if not _ROW_ACCESS_POLICIES or not re.match(r"\s*SELECT\b", duckdb_sql, re.IGNORECASE):
+        return duckdb_sql
+    from bigquery_emulator.engine.sanitize import duckdb_schema_name
+
+    result = duckdb_sql
+    for key, policies in _ROW_ACCESS_POLICIES.items():
+        pol_project, ds, table = key.split(".", 2)
+        if pol_project != project_id or not policies:
+            continue
+        schema = duckdb_schema_name(project_id, ds or dataset_id)
+        table_pat = rf'FROM\s+((?:"{re.escape(schema)}"\.)?(?:"{re.escape(table)}"|{re.escape(table)}))(\s+AS\s+"?\w+"?)?'
+        predicate = " AND ".join(f"({p})" for p in policies.values())
+        if re.search(table_pat, result, re.IGNORECASE):
+            if re.search(r"\bWHERE\b", result, re.IGNORECASE):
+                result = re.sub(r"\bWHERE\b", f"WHERE {predicate} AND ", result, count=1, flags=re.IGNORECASE)
+            else:
+                result = re.sub(
+                    table_pat,
+                    lambda m: f'FROM {m.group(1)}{m.group(2) or ""} WHERE {predicate}',
+                    result,
+                    count=1,
+                    flags=re.IGNORECASE,
+                )
+    return result
+
+
+def _duckdb_result_to_bq(result) -> dict[str, Any]:
+    desc = result.description or []
+    columns = [(str(c[0]), str(c[1]) if len(c) > 1 else "VARCHAR") for c in desc]
+    schema_fields = duckdb_columns_to_bq_schema(columns)
+    rows = []
+    for row in result.fetchall():
+        rows.append({"f": [python_to_bq_value_for_field(v, schema_fields[i]) for i, v in enumerate(row)]})
+    return {"schema": {"fields": schema_fields}, "rows": rows, "totalRows": str(len(rows))}
+
