        "minTier": "community",
        "gcloudApiName": "cloudtasks",
        "terraformEnvVar": "GOOGLE_CLOUD_TASKS_CUSTOM_ENDPOINT",
        "config": {
          "task_name_reuse_window_seconds": 0,
          "queue_name_reuse_window_seconds": 0,
