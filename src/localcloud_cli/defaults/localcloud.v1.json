{
  "version": 1,
  "context": {
    "project": "local-gcp-project"
  },
  "host": {
    "transparent_network": false,
    "data_volume": "localcloud-data",
    "backup_dir": "~/.localcloud/backups",
    "data": "persistent",
    "docker_socket": "auto",
    "network_name": "localcloud"
  },
  "tls": {
    "enabled": false,
    "port": 5381,
    "certificate": "",
    "private_key": ""
  },
  "mcp": {
    "write": false,
    "destructive": false,
    "allow_remote": false
  },
  "updater": {
    "enabled": true,
    "auto_update": false,
    "auto_restart_container": false,
    "check_interval_hours": 24,
    "image": ""
  },
  "server": {
    "data_dir": "/var/lib/localcloud",
    "gateway": {
      "port": 5380
    },
    "control_token": {
      "value": ""
    },
    "console": {
      "enabled": true
    },
    "persistence": true,
    "auto_seed": true,
    "unknown_project": "provision",
    "auto_provision_projects": true,
    "allowed_origins": [],
    "allowed_hosts": [],
    "query_max_rows": 10000,
    "query_max_bytes": 8388608,
    "query_history_keep_rows": 0,
    "migration_run_keep_rows": 0,
    "operation_retention_hours": 0,
    "usage": {
      "sample_interval_seconds": 900
    },
    "identity": {
      "enabled": true,
      "issuer_url": "auto",
      "id_token_lifetime_seconds": 3600,
      "access_token_lifetime_seconds": 3600,
      "clock_skew_seconds": 60,
      "gateway_metadata": "auto",
      "relay_image": ""
    },
    "gcp_credentials": {
      "source": "none"
    },
    "postgres": {
      "host": "localhost",
      "port": 5391,
      "database": "localcloud",
      "user": "localcloud",
      "password": "localcloud"
    }
  },
  "services": {
    "enabled": "default",
    "catalog": {
      "gcs": {
        "displayName": "Cloud Storage",
        "availability": "available",
        "resettableData": true,
        "plaintextPort": 5382,
        "tlsPort": 5392,
        "protocol": "rest",
        "envVar": "STORAGE_EMULATOR_HOST",
        "envValuePrefix": "http://",
        "type": "external",
        "gatewayObservable": true,
        "defaultEnabled": true,
        "minTier": "community",
        "gcloudApiName": "storage",
        "terraformEnvVar": "GOOGLE_STORAGE_CUSTOM_ENDPOINT",
        "config": {
          "lifecycle_interval_seconds": 0
        },
        "config_descriptions": {
          "lifecycle_interval_seconds": "Seconds between runs of the buckets' lifecycle rules (Delete, SetStorageClass, AbortIncompleteMultipartUpload). Cloud Storage applies them asynchronously, about once a day. 0 (the default) never runs them on a timer; POST /mutate/gcs/lifecycle/run runs them once."
        },
        "observability": {
          "logs": {
            "resourceType": "localcloud_service",
            "sources": [
              {
                "id": "emulator-process",
                "component": "fake-gcs-server",
                "strategy": "collector",
                "fallback": "raw-only",
                "kind": "supervisor",
                "program": "fake-gcs-server",
                "streams": [
                  "stdout",
                  "stderr"
                ],
                "paths": {
                  "stdout": "/var/log/localcloud/fake-gcs-server-stdout.log",
                  "stderr": "/var/log/localcloud/fake-gcs-server-stderr.log"
                },
                "format": "text",
                "retentionProfile": "external-process"
              }
            ]
          }
        }
      },
      "pubsub": {
        "displayName": "Pub/Sub",
        "availability": "available",
        "resettableData": true,
        "plaintextPort": 5383,
        "tlsPort": 5393,
        "protocol": "grpc",
        "envVar": "PUBSUB_EMULATOR_HOST",
        "envValuePrefix": "",
        "type": "facade",
        "gatewayObservable": true,
        "defaultEnabled": true,
        "minTier": "community",
        "gcloudApiName": "pubsub",
        "terraformEnvVar": "GOOGLE_PUBSUB_CUSTOM_ENDPOINT",
        "config": {
          "enforce_subscription_retention": false,
          "subscription_retention_days": 7
        },
        "config_descriptions": {
          "enforce_subscription_retention": "Expire subscription messages by age, as Pub/Sub does. Off (the default), no message expires: unacknowledged messages, and the acknowledged ones a subscription retains, stay until they are acknowledged, purged or their subscription is deleted, whatever message_retention_duration the subscription names, and the resource still reports the retention it was given. Retained messages are held in memory and loaded at startup, so a backlog that is never consumed grows both: purge it, or turn this on. Set true to test retention: a message then expires past its subscription's message_retention_duration, or past subscription_retention_days when it names none. Applies from the next start.",
          "subscription_retention_days": "Days a subscription keeps its messages when it sets no message_retention_duration, while enforce_subscription_retention is on. The default is Google's 7 days; 0 keeps them until they are acknowledged or purged. A subscription's message_retention_duration, when set, always wins. Applies to every subscription that sets none, from the next start."
        },
        "observability": {
          "logs": {
            "resourceType": "localcloud_service",
            "sources": [
              {
                "id": "java-runtime",
                "component": "pubsub",
                "strategy": "direct",
                "fallback": "raw-only",
                "kind": "internal",
                "paths": {
                  "raw": "/var/log/localcloud/localcloud-server.log"
                },
                "format": "json",
                "retentionProfile": "java-facade"
              }
            ]
          }
        }
      },
