        "config_descriptions": {
          "activity_retention_days": "Days of completed task attempts the Local activity view keeps; 0 keeps them until cleared. Set 7 to test the window the activity view once showed.",
          "queue_name_reuse_window_seconds": "Seconds a queue name stays unavailable after its queue is deleted; creating it again answers FAILED_PRECONDITION. 0 turns the window off, so a name is reusable at once. Google documents a window of up to 3 days (259200). Valid range is 0 to 777600 (9 days).",
          "task_name_reuse_window_seconds": "Seconds a task ID stays unavailable after its task is deleted, completes, exhausts its retries or is purged; creating that ID again answers ALREADY_EXISTS. 0 turns the window off, so an ID is reusable at once. Google releases an ID after up to 24 hours (86400). Valid range is 0 to 777600 (9 days)."
        },
        "observability": {
          "logs": {
            "resourceType": "localcloud_service",
            "sources": [
              {
                "id": "java-runtime",
                "component": "cloudtasks",
