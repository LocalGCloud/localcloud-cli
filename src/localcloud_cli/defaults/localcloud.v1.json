          "runtime_retention_days": "Retain LocalCloud runtime logs for this many days; 0 keeps them until runtime_max_size_mb trims them.",
          "runtime_max_size_mb": "LocalCloud runtime-log storage budget in MiB. Past it the oldest runtime entries are removed; 0 sets no budget.",
          "raw_retention_hours": "Reserved and not enforced yet: container-local raw fallback logs are kept until the logging budgets trim them. 0 is the only value that matches current behaviour.",
          "raw_max_size_mb": "Container-local raw fallback-log storage budget in MiB.",
          "total_max_size_mb": "Hard combined budget for application, runtime, and raw logs in MiB.",
          "warning_watermark_percent": "Usage percentage that reports warning pressure.",
          "critical_watermark_percent": "Usage percentage that triggers aggressive runtime cleanup.",
          "hard_watermark_percent": "Usage percentage that requires synchronous reclamation or drops.",
