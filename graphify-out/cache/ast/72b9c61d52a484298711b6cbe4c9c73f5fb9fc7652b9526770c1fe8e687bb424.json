          <option value=\"5xx\">5xx Server Error</option>\n                </select>\n\n                    <label for=\"logs-auto-refresh\">\n                        <input\n                            id=\"logs-auto-refresh\"\n                            name=\"logs-auto-refresh\"\n                            type=\"checkbox\"\n                            checked={autoRefresh()}\n                            onChange={e => toggleAutoRefresh(e.currentTarget.checked)}\n                    />\n                    Auto-refresh\n                </label>\n\n                <label class=\"refresh-interval-label\" for=\"logs-refresh-interval\">\n                    Every\n                    <input\n                        id=\"logs-refresh-interval\"\n                        name=\"logs-refresh-interval\"\n                        autocomplete=\"off\"\n                        type=\"number\"\n                        min=\"1\"\n                        max=\"60\"\n                        value={refreshInterval()}\n                        onChange={e => applyInterval(parseInt(e.currentTarget.value) || 3)", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/localcloud-console/src/pages/Logs.jsx", "source_location": "L113"}, {"caller_nid": "pages_logs_logs", "callee": "error", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/localcloud-console/src/pages/Logs.jsx", "source_location": "L120"}, {"caller_nid": "pages_logs_logs", "callee": "error", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/localcloud-console/src/pages/Logs.jsx", "source_location": "L121"}, {"caller_nid": "pages_logs_logs", "callee": "methodFilter", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/localcloud-console/src/pages/Logs.jsx", "source_location": "L130"}, {"caller_nid": "pages_logs_logs", "callee": "autoRefresh", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/loca