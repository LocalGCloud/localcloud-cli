ython-sdk-demo/src/pages/Settings.jsx", "source_location": "L16"}, {"caller_nid": "pages_settings_settings", "callee": "(\n    <div class=\"page settings-page\">\n      <div class=\"page-header\">\n        <h2>Settings</h2>\n        <p class=\"subtitle\">Configure Dashboard & Environment</p>\n      </div>\n\n      {/* Display Settings */}\n      <div class=\"settings-section\">\n        <h3>Display Settings</h3>\n\n        <div class=\"setting-item\">\n          <label for=\"dark-mode-toggle\" class=\"setting-label\">\n            <span class=\"label-text\">Dark Mode</span>\n            <input\n              id=\"dark-mode-toggle\"\n              type=\"checkbox\"\n              checked={darkMode()}\n              onchange={(e) => setDarkMode(e.target.checked)}\n              class=\"checkbox\"\n            />\n          </label>\n          <p class=\"setting-description\">Toggle between light and dark theme</p>\n        </div>\n\n        <div class=\"setting-item\">\n          <label for=\"refresh-interval\" class=\"setting-label\">\n            <span class=\"label-text\">Auto-Refresh Interval</span>\n          </label>\n          <div class=\"setting-input\">\n            <input\n              id=\"refresh-interval\"\n              type=\"number\"\n              min=\"1\"\n              max=\"60\"\n              value={refreshInterval()}\n              onchange={(e) => setRefreshInterval(parseInt(e.target.value))}\n              class=\"input-field\"\n            />\n            <span class=\"unit\">seconds</span>\n          </div>\n          <p class=\"setting-description\">How often to refresh service status and logs</p>\n        </div>\n\n        <div class=\"setting-item\">\n          <label for=\"auto-tail-logs\" class=\"setting-label\">\n            <span class=\"label-text\">Auto-Tail Logs</span>\n            <input\n              id=\"auto-tail-logs\"\n              type=\"checkbox\"\n              checked={autoTailLogs()}\n              onchange={(e) => setAutoTailLogs(e.target.checked)}\n              class=\"checkbox\"\n            />\n          </label>\n          <p class=\"setting-description\">Automatically update request logs</p>\n        </div>\n\n        <div class=\"setting-actions\">\n          <button class=\"btn btn-primary\" onclick={handleSaveSettings}>\n            Save Settings\n          </button>\n          <Show when={copiedText()}>\n            <span class=\"success-message\">{copiedText()}</span>\n          </Show>\n        </div>\n      </div>\n\n      {/* Environment Variables Export */}\n      <div class=\"settings-section\">\n        <h3>Environment Variables</h3>\n        <p class=\"section-description\">\n          Export environment variables for your application to use LocalCloud emulated services.\n        </p>\n\n        <div class=\"export-options\">\n          <div class=\"export-format\">\n            <h4>Shell Format</h4>\n            <p>Copy and paste into your terminal with: <code>eval $(localcloud env --format=shell)</code></p>\n            <button\n              class=\"btn btn-secondary\"\n              onclick={()", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/examples/python-sdk-demo/src/pages/Settings.jsx", "source_location": "L49"}, {"caller_nid": "pages_settings_settings", "callee": "darkMode", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/examples/python-sdk-demo/src/pages/Settings.jsx", "source_location": "L66"}, {"caller_nid": "pages_settings_settings", "callee": "refreshInterval", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/examples/python-sdk-demo/src/pages/Settings.jsx", "source_location": "L84"}, {"caller_nid": "pages_settings_settings", "callee": "autoTailLogs", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/examples/python-sdk-demo/src/pages/Settings.jsx", "source_location": "L99"}, {"caller_nid": "pages_settings_settings", "callee": "copiedText", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/examples/python-sdk-demo/src/pages/Settings.jsx", "source_location": "L111"}, {"caller_nid": "pages_settings_settings", "callee": "eval", "is_member_call": false, "source_file": "/Users/jsenjaliya/src/AI/localcloud/examples/python-sdk-demo/src/pages/Settings.jsx", "source_location": "L127"}]}