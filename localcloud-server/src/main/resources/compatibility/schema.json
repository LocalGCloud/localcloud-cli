{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cloud/schemas/compatibility.schema.json",
  "title": "LocalCloud Compatibility Registry",
  "type": "object",
  "required": ["service_id", "coverage_status"],
  "properties": {
    "service_id": { "type": "string" },
    "coverage_status": { "$ref": "#/$defs/status" },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "terraform_resources": { "$ref": "#/$defs/surface" },
    "gcloud_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" }
    },
    "console_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" }
    },
    "state": { "type": "object" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "unsupported_operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/unsupportedOperation" }
    },
    "ci_recommendation": { "type": "string" }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["supported", "partial", "unsupported", "unverified", "planned", "early-partial"]
    },
    "operation": {
      "type": "object",
      "required": ["id", "operation", "status"],
      "properties": {
        "id": { "type": "string" },
        "operation": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "sdk": { "type": "object" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "surface": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "resources": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "path": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "warning": {
      "type": "object",
      "required": ["id", "surface", "keyword", "message"],
      "properties": {
        "id": { "type": "string" },
        "surface": { "type": "string" },
        "keyword": { "type": "string" },
        "severity": { "type": "string" },
        "message": { "type": "string" },
        "workaround": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "unsupportedOperation": {
      "type": "object",
      "required": ["id", "operation", "surface", "reason"],
      "properties": {
        "id": { "type": "string" },
        "operation": { "type": "string" },
        "surface": { "type": "string" },
        "path_pattern": { "type": "string" },
        "http_status": { "type": "integer" },
        "reason": { "type": "string" },
        "workaround": { "type": "string" }
      }
    }
  }
}
